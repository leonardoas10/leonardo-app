{
    "name": "leonardo-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "sandbox": "npx dotenvx run --env-file=.env -- ampx sandbox --profile leonardo --stream-function-logs true",
        "lint": "next lint",
        "type-check": "tsc --noEmit && tsc -p amplify/tsconfig.json --noEmit",
        "generate:thumbhashes": "tsx scripts/generate-thumbhashes.ts",
        "pre-commit": "npm run lint && npm run type-check",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky install"
    },
    "dependencies": {
        "@aws-amplify/adapter-nextjs": "^1.6.3",
        "@aws-amplify/ui-react": "^6.11.2",
        "@aws-lambda-powertools/logger": "^2.20.0",
        "@aws-sdk/client-s3": "3.821.0",
        "@aws-sdk/client-ses": "^3.821.0",
        "@dotenvx/dotenvx": "^1.44.1",
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^7.1.0",
        "@mui/material": "^7.1.0",
        "@mui/material-nextjs": "^9.1.1",
        "@next/third-parties": "^15.3.3",
        "aws-amplify": "^6.15.0",
        "i18next": "^25.2.1",
        "i18next-browser-languagedetector": "^8.1.0",
        "next": "^15.3.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^15.5.2"
    },
    "devDependencies": {
        "@aws-amplify/backend": "^1.16.1",
        "@aws-amplify/backend-cli": "^1.7.2",
        "@eslint/eslintrc": "^3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "critters": "^0.0.25",
        "eslint": "^9",
        "eslint-config-next": "15.3.2",
        "husky": "^8.0.0",
        "json-schema-to-ts": "3.1.1",
        "sharp": "^0.35.3",
        "thumbhash": "^0.1.1",
        "ts-algebra": "2.0.0",
        "tsx": "^4.23.2",
        "typescript": "^5.8.3",
        "vitest": "^4.1.10",
        "yaml": "^2.4.2"
    },
    "overrides": {
        "aws-cdk-lib": "2.189.1",
        "@smithy/util-utf8": "4.0.0",
        "@smithy/util-base64": "4.0.0",
        "@smithy/util-buffer-from": "4.0.0"
    }
}
